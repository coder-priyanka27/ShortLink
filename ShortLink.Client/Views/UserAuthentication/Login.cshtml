@model LoginViewModel;
@{
    ViewData["Title"] = "Log in to your account";
}
<div class="row">
    <div class="col-md-6 offset-md-3">
        <h4 class="form-header">Log in to your account</h4>

        <div class="row">
            <div class="col-md-8 offset-md-2">

                <form asp-controller="UserAuthentication" asp-action="LoginSubmitted">
                    <div class="form-group mb-3">
                        <lable for="emailAddress">Email Address</lable>
                        <input type="email" asp-for="EmailAddress" class="form-control" id="emailAddress" placeholder="Enter email" />
                        <small id="emailAddressSm" class="form-text text-muted">We will never share your email with anyone else.</small>
                    </div>
                    <div form-group mb-3>
                        <labl for="password">Password</labl>
                        <input type="password" asp-for="Password" name="password" class="form-control" id="password" placeholder="Enter password" />
                    </div>

                    @* <button type="submit" class="btn btn-outline-success mt-2 btn-login">
                        Log In
                    </button> *@
                     <button onclick="login" class="btn btn-outline-success mt-2 btn-login">
                        Log In
                    </button> 
                </form>
            </div>
        </div>
    </div>
</div>

<script>
     function login()
     {
        var emailAddress = $("#emailAddress").val();
       var password = $("#password").val();

       $.ajax({
         url: '@Url.Action("UserAuthentication", "UserAuthentication")',
         type: 'POST',
         dataType: 'json',
         data: {
            EmailAddress : emailAddress,
            Password : password
         },
         sucess: function(response){
             console.log("Login successful!");
         },
         error: function(xhr, status, error){
             console.log("Login failed");
         }
       });
     }
</script>